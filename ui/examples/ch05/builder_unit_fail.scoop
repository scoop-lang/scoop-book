//! dep: scoop:scoop.ui.style:0.1.0
//! dep: scoop:scoop.ui.style.shadcn:0.1.0
import scoop.ui.*
import scoop.ui.component.*
import scoop.ui.style.ThemeMode
import scoop.ui.style.ThemeSource
import scoop.ui.style.shadcn.shadcnTheme

class Boxed(scope: ComponentScope) : Component(scope) {
    public override fun render(): View = column {
        // Error: inside the block, label(...) appends a child and returns Unit.
        frame(label("boxed")) { width = Some(80.0) }
    }
}

fun main() {
    context(ThemeSource(shadcnTheme(ThemeMode.Light))) {
        runUiApplication("Boxed", { scope -> Boxed(scope) })
    }
}
