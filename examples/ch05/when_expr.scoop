fun describe(score: Int): String =
    when (score) {
        100 -> "perfect"
        90, 95 -> "excellent"
        in 60 .. 89 -> "pass"
        in 0 ..< 60 -> "fail"
        else -> "invalid"
    }

fun bmiClass(bmi: Double): String =
    when {
        bmi < 18.5 -> "underweight"
        bmi < 24.0 -> "normal"
        bmi < 28.0 -> "overweight"
        else -> "obese"
    }

fun main() {
    println(describe(100))
    println(describe(95))
    println(describe(72))
    println(describe(12))
    println(describe(-3))

    println(bmiClass(22.5))
    println(bmiClass(30.1))

    // 分支体可以是块，最后一个表达式是结果
    val day = 6
    val kind =
        when (day) {
            6, 7 -> {
                println("no alarm today")
                "weekend"
            }
            else -> "workday"
        }
    println(kind)

    // 作为语句、subject 是 Int：可以不穷尽，没有分支命中就什么也不做
    when (day) {
        1 -> println("start of the week")
        5 -> println("almost there")
    }
    println("done")
}
