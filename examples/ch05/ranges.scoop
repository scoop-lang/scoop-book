fun show(label: String, range: IntRange) {
    val line = StringBuilder()
    for (i in range) {
        line.append(f"${i} ")
    }
    println(f"${label}: ${line.toString()}")
}

fun main() {
    show("1..5", 1 .. 5)
    show("1..<5", 1 ..< 5)
    show("1 until 5", 1 until 5)
    show("5 downTo 1", 5 downTo 1)
    show("0..10 step 3", 0 .. 10 step 3)
    show("10 downTo 0 step 4", 10 downTo 0 step 4)
    show("5..1", 5 .. 1)

    // 区间也能用来判断“在不在里面”
    val hour = 14
    println(hour in 9 .. 17)
    println(hour !in 0 ..< 6)
    println((0 .. 10 step 3).contains(6))
    println((0 .. 10 step 3).contains(7))

    // Long 的区间是 LongRange
    var total = 0L
    for (n in 1L .. 100L) {
        total += n
    }
    println(total)

    // 端点是最大值也能正常结束
    var count = 0
    for (n in Int.MAX_VALUE - 2 .. Int.MAX_VALUE) {
        count++
    }
    println(count)
}
