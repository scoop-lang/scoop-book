package book.geometry

public interface Shape {
    public val name: String

    public fun area(): Double
}

public class Circle public constructor(private val radius: Double) : Shape {
    public override val name: String = "circle"

    public override fun area(): Double = PI * radius * radius
}

public class Rect private constructor(public val width: Double, public val height: Double) : Shape {
    public override val name: String = "rect"

    public override fun area(): Double = width * height

    public companion object {
        public fun of(width: Double, height: Double): Rect {
            requireNonNegative(width, "width")
            requireNonNegative(height, "height")
            return Rect(width, height)
        }

        public fun square(side: Double): Rect = of(side, side)
    }
}

public fun totalArea(shapes: Array<Shape>): Double {
    var sum = 0.0
    for (shape in shapes) {
        sum = sum + shape.area()
    }
    return sum
}
