infix fun Int.pow(exponent: Int): Int {
    var result = 1
    for (i in 1 .. exponent) {
        result *= this
    }
    return result
}

class Tag(val name: String) {
    public infix fun with(child: String): String = f"<${name}>${child}</${name}>"
}

fun main() {
    println(2 pow 10)
    println(2.pow(10))
    println(1 + 2 pow 2)
    println(Tag("b") with "bold")
}
