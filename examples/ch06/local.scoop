fun frame(lines: Array<String>, width: Int): String {
    val border = "|"

    fun pad(text: String): String {
        val result = StringBuilder()
        result.append(text)
        var length = text.charLength
        while (length < width.toLong()) {
            result.append(" ")
            length += 1L
        }
        return result.toString()
    }

    fun row(text: String): String = f"${border} ${pad(text)} ${border}"

    val result = StringBuilder()
    for (line in lines) {
        result.append(row(line))
        result.append("\n")
    }
    return result.toString()
}

fun factorial(n: Int): Long {
    fun loop(k: Int, acc: Long): Long =
        if (k <= 1)
            acc
        else
            loop(k - 1, acc * k.toLong())
    return loop(n, 1L)
}

fun main() {
    print(frame(["Scoop", "fun"], 6))
    println(factorial(20))
}
