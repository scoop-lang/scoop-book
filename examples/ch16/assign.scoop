struct Money(val cents: Long) : ToString {
    operator fun plus(other: Money): Money = Money(cents + other.cents)

    operator fun inc(): Money = Money(cents + 1L)

    public override fun toString(): String {
        val rest = cents % 100L
        val pad = if (rest < 10L) "0" else ""
        return f"${cents / 100L}.${pad}${rest} USD"
    }
}

class Basket {
    private val items = ArrayList<String>()

    operator fun plusAssign(item: String) {
        items.add(item)
    }

    val count: Long
        get() = items.size
}

fun main() {
    var total = Money(1999L)
    total += Money(1L)
    println(total)
    total++
    println(total)

    val basket = Basket()
    basket += "apple"
    basket += "pear"
    println(basket.count)
}
