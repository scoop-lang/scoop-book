struct Vec2(val x: Int, val y: Int): Add<Vec2, Vec2>, ToString {
    public override operator fun plus(other: Vec2): Vec2 = Vec2(x + other.x, y + other.y)

    public override fun toString(): String = f"(${x}, ${y})"
}

fun <T: Add<T, T>> total(start: T, values: Array<T>): T {
    var sum = start
    for (value in values) {
        sum = sum + value
    }
    return sum
}

fun main() {
    println(total(0, [1, 2, 3, 4]))
    println(total(0.5, [0.25, 0.25]))
    println(total("", ["a", "b", "c"]))
    println(total(Vec2(0, 0), [Vec2(1, 2), Vec2(3, 4)]))
}
