abstract class Shape(val name: String) {
    abstract fun area(): Double

    open fun describe(): String = f"${name}: ${area()}"
}

open class Rect(val w: Double, val h: Double): Shape("rect") {
    final override fun area(): Double = w * h
}

class Square(side: Double): Rect(side, side) {
    override fun describe(): String = "square, " + super.describe()
}

class Circle(val r: Double): Shape("circle") {
    override fun area(): Double = 3.0 * r * r
}

fun main() {
    val shapes: Array<Shape> = [Rect(2.0, 3.0), Square(2.0), Circle(1.0)]
    for (s in shapes) {
        println(s.describe())
    }
}
