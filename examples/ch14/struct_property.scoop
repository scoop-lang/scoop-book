interface Named {
    val name: String
}

struct City(val label: String, val country: String): Named {
    override val name: String
    get() = f"${label}, ${country}"
}

class Person(override val name: String): Named

fun main() {
    val names: Array<Named> = [City("Lyon", "France") as Named, Person("Ada")]
    for (n in names) {
        println(n.name)
    }
}
