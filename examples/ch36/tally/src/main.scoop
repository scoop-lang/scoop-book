package book.tally

fun report(t: Tally) {
    println(f"empty mean: ${t.mean ?: -1.0}")
    for (v in [2.0, 4.0, 4.0, 4.0, 5.0, 5.0, 7.0, 9.0])
        t.add(v)
    println(f"count: ${t.count}")
    println(f"mean: ${t.mean ?: -1.0}")
    println(f"stddev: ${t.stddev ?: -1.0}")
}

fun main() {
    // use 结束时一定调用 close，C 那边的内存随之释放（第 21 章）
    Tally().use { t -> report(t) }
}
