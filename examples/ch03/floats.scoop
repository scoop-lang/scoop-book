fun main() {
    val d = 1.5
    val f = 1.5f
    val g: Float = 0.1
    println(d)
    println(f)
    println(g)
    println(0.1 + 0.2)
    println(1e3)
    println(2.5e10)

    println(1.0 / 0.0)
    println(0.0 / 0.0)
    val nan = Double.NaN
    println(nan == nan)
    println(nan.isNaN())

    println(3.9.toInt())
    println((-3.9).toInt())
    println(1e20.toInt())
    println(nan.toInt())
    println(f.toDouble() + d)
}
