import scoop.compiler.env

val buildChannel: String = env("SCOOP_BOOK_CHANNEL") ?: "dev"

fun main() {
    println(f"channel=${buildChannel}")
    val present =
        when (env("SCOOP_BOOK_UNSET_EXAMPLE")) {
            case Some(_) -> "set"
            case None -> "not set"
        }
    println(f"SCOOP_BOOK_UNSET_EXAMPLE is ${present}")
}
