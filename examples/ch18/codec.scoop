//! dep: scoop:scoop.json:0.1.0

import scoop.json.*

enum Role {
    Admin,
    Member(val since: Int)

    @GenerateWith("scoop.codec", ["ValueEncoder<Role>", "ValueDecoder<Role>"])
    public companion object : ValueEncoder<Role>, ValueDecoder<Role>
}

struct User(
    val name: String,
    @Serialize(rename = "e-mail") val email: String? = None,
    val roles: Array<Role> = [],
    @Serialize(ignore = true) val cachedScore: Int = 0
) {
    @GenerateWith("scoop.codec", ["ValueEncoder<User>", "ValueDecoder<User>"])
    public companion object : ValueEncoder<User>, ValueDecoder<User>
}

fun main() {
    val ada = User(
        "Ada",
        email = Some("ada@example.com"),
        roles = [Role.Admin, Role.Member(2024)],
        cachedScore = 99
    )
    val text = Json.encodeToString(ada)
    println(text)

    val back = Json.decodeFromString<User>(text)
    println(f"${back.name} ${back.email ?: "-"} roles=${back.roles.size}")
    println(f"cachedScore=${back.cachedScore}")

    val minimal = Json.decodeFromString<User>("""{"name": "Grace"}""")
    println(f"${minimal.name} ${minimal.email ?: "-"} roles=${minimal.roles.size}")
}
