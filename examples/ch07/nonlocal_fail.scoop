fun forEachValue(values: Array<Int>, action: (Int) -> Unit) {
    for (value in values)
        action(value)
}

fun firstNegative(values: Array<Int>): Int {
    forEachValue(values) {
        if (it < 0)
            return@firstNegative it
    }
    return 0
}

fun main() {
    println(firstNegative([1, -2, 3]))
}
