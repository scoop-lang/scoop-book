import scoop.*
import scoop.text.*

fun parseQuantity(text: String): Result<Int, String> = text
    .toIntOrNone()
    .toResult { f"not a number: ${text}" }

fun main() {
    val checked = parseQuantity("12")
        .flatMap { quantity ->
            if (quantity <= 10) Result.Success(quantity) else Result.Failure("out of stock")
        }
}
