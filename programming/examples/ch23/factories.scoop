import scoop.collections.*

fun main() {
    // 键值对写成 tuple
    val capitals = mapOf(("France", "Paris"), ("Japan", "Tokyo"))
    println(capitals["Japan"] ?: "?")

    // 用 for 解构遍历：每个条目是一个 Map.Entry，有 key 和 value 两个字段
    for ((country, city) in capitals) {
        println(f"${country} -> ${city}")
    }

    // keys、values、entries 是跟随 Map 变化的只读视图
    val scores = mutableMapOf(("ada", 90))
    val names = scores.keys
    scores["bob"] = 75
    println(f"${names.size} names: ${names.joinToString()}")
    println(scores.values.joinToString())

    // tuple 的列表可以直接转成 Map
    val pairs = [("x", 1), ("y", 2)]
    val lookup = pairs.toMap()
    println(lookup["y"] ?: 0)
}
